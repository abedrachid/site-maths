---
/* ────────────────────────────────────────────────────────────
   MathsElites — Archives des devoirs & examens
   Une seule brique pour les 4 espaces :
     <ArchiveDevoirs type="ds" />        devoirs surveillés
     <ArchiveDevoirs type="dm" />        devoirs à la maison
     <ArchiveDevoirs type="eb" />        examens blancs
     <ArchiveDevoirs type="national" />  examens nationaux (matrice 15 sessions)
   Données : src/data/devoirs.mjs (seul fichier à modifier).
   Un PDF absent de public/ s'affiche « Bientôt » (jamais de lien cassé).
   ──────────────────────────────────────────────────────────── */
import fs from 'node:fs';
import path from 'node:path';
import {
  devoirs, examensNationaux, NIVEAUX, TYPES, FILIERES,
  NB_ANNEES, RENTREE_COURANTE, SESSION_COURANTE,
} from '../data/devoirs.mjs';

interface Props { type: 'ds' | 'dm' | 'eb' | 'national' }
const { type } = Astro.props;
const T = TYPES[type];

const PUB = path.join(process.cwd(), 'public');
const exists = (p?: string) => {
  if (!p) return false;
  try { return fs.existsSync(path.join(PUB, decodeURIComponent(p.split(/[?#]/)[0]))); }
  catch { return false; }
};
const norm = (s: string) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const slug = (s: string) => norm(s).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const today = new Date();
const isNew = (d?: string) => !!d && (today.getTime() - new Date(d + 'T00:00:00').getTime()) < 30 * 86400000;
const anneeLabel = (a: number) => `${a}–${a + 1}`;
const anneeCourt = (a: number) => `${a}–${String(a + 1).slice(2)}`;

/* ── Barre de navigation entre les 4 espaces ── */
const espaces = (['ds', 'dm', 'eb', 'national'] as const).map((k) => ({ k, ...TYPES[k] }));

/* ══════════ DS · DM · EB ══════════ */
const ordreNiveaux = ['premiere', 'terminale', 'terminale-pc', 'prepas'];
let items: any[] = [];
let annees: number[] = [];
let niveauxPresents: string[] = [];
if (type !== 'national') {
  items = devoirs
    .filter((d) => d.type === type)
    .map((d) => {
      const okS = exists(d.sujet);
      const okC = exists(d.corrige);
      return {
        ...d, okS, okC, dispo: okS || okC, nouveau: isNew(d.ajout),
        id: `${d.niveau}-${d.annee}-${slug((d.categorie || '') + '-' + d.titre)}`,
        search: norm([d.titre, d.chapitres, d.categorie, NIVEAUX[d.niveau]?.label].filter(Boolean).join(' ')),
      };
    });
  const set = new Set<number>();
  for (let a = RENTREE_COURANTE; a > RENTREE_COURANTE - NB_ANNEES; a--) set.add(a);
  items.forEach((d) => set.add(d.annee)); // ne jamais masquer un devoir hors fenêtre
  annees = [...set].sort((a, b) => b - a);
  niveauxPresents = ordreNiveaux.filter((n) => items.some((d) => d.niveau === n));
}
const tri = (a: any, b: any) =>
  (Number(b.dispo) - Number(a.dispo)) ||
  (a.categorie || '').localeCompare(b.categorie || '', 'fr') ||
  a.titre.localeCompare(b.titre, 'fr', { numeric: true });

const parAnnee = annees.map((a) => {
  const list = items.filter((d) => d.annee === a);
  return {
    annee: a,
    nbDispo: list.filter((d) => d.dispo).length,
    nbAVenir: list.filter((d) => !d.dispo).length,
    groupes: ordreNiveaux
      .map((n) => ({ niveau: n, list: list.filter((d) => d.niveau === n).sort(tri) }))
      .filter((g) => g.list.length),
  };
});
const premiereAnneeOuverte = parAnnee.find((y) => y.nbDispo > 0)?.annee;

const nbDocs = items.filter((d) => d.dispo).length;
const nbCorriges = items.filter((d) => d.okC).length;

/* ══════════ EXAMENS NATIONAUX ══════════ */
const nat = examensNationaux.map((e) => ({ ...e, okS: exists(e.sujet), okC: exists(e.corrige) }));
const filieres = Object.entries(FILIERES).map(([k, f]) => {
  const rows: any[] = [];
  for (let a = SESSION_COURANTE; a > SESSION_COURANTE - NB_ANNEES; a--) {
    rows.push({
      annee: a,
      normale: nat.find((e) => e.filiere === k && e.annee === a && e.session === 'normale'),
      rattrapage: nat.find((e) => e.filiere === k && e.annee === a && e.session === 'rattrapage'),
    });
  }
  const list = nat.filter((e) => e.filiere === k);
  return { k, ...f, rows, nbSujets: list.filter((e) => e.okS).length, nbCorriges: list.filter((e) => e.okC).length };
});
const natSujets = nat.filter((e) => e.okS).length;
const natCorriges = nat.filter((e) => e.okC).length;
const sessionLabel = { normale: 'Session normale', rattrapage: 'Rattrapage' };
---

<div class="ar-root not-content" data-type={type}>

  {/* ── Accès rapide aux 4 espaces ── */}
  <nav class="ar-switch" aria-label="Espaces devoirs et examens">
    {espaces.map((e) => (
      <a href={e.url} class:list={['ar-switch-item', { 'is-active': e.k === type }]} aria-current={e.k === type ? 'page' : undefined}>
        <span class="ar-switch-emoji" aria-hidden="true">{e.emoji}</span>
        <span>{e.titre}</span>
      </a>
    ))}
  </nav>

  {/* ── Bandeau ── */}
  <header class="ar-hero">
    <p class="ar-hero-txt">{T.accroche}</p>
    <div class="ar-stats">
      {type === 'national' ? (
        <>
          <div class="ar-stat"><b>{NB_ANNEES}</b><span>sessions couvertes</span></div>
          <div class="ar-stat"><b>{natSujets}</b><span>sujet{natSujets > 1 ? 's' : ''} en ligne</span></div>
          <div class="ar-stat"><b>{natCorriges}</b><span>corrigé{natCorriges > 1 ? 's' : ''}</span></div>
        </>
      ) : (
        <>
          <div class="ar-stat"><b>{NB_ANNEES}</b><span>années scolaires</span></div>
          <div class="ar-stat"><b>{nbDocs}</b><span>document{nbDocs > 1 ? 's' : ''} en ligne</span></div>
          <div class="ar-stat"><b>{nbCorriges}</b><span>corrigé{nbCorriges > 1 ? 's' : ''}</span></div>
        </>
      )}
    </div>
  </header>

  {type !== 'national' ? (
    <>
      {/* ── Filtres ── */}
      <div class="ar-tools" role="search">
        <div class="ar-chips" role="group" aria-label="Filtrer par niveau">
          <button type="button" class="ar-chip is-active" data-niveau="all">Tous les niveaux</button>
          {niveauxPresents.map((n) => (
            <button type="button" class="ar-chip" data-niveau={n} style={`--c:${NIVEAUX[n].couleur}`}>
              <i aria-hidden="true"></i>{NIVEAUX[n].label}
            </button>
          ))}
        </div>
        <div class="ar-tools-row">
          <label class="ar-search">
            <span aria-hidden="true">🔎</span>
            <input type="search" placeholder="Chercher un chapitre : limites, suites, complexes…" aria-label="Chercher un chapitre" />
          </label>
          <label class="ar-toggle">
            <input type="checkbox" class="ar-dispo-only" />
            <span>Seulement les documents en ligne</span>
          </label>
        </div>
      </div>

      {/* ── Frise des 15 années ── */}
      <div class="ar-years" aria-label="Aller à une année">
        {parAnnee.map((y) => (
          <a href={`#annee-${y.annee}`} class:list={['ar-year-chip', { 'is-empty': !y.nbDispo, 'is-current': y.annee === RENTREE_COURANTE }]} data-annee={y.annee}>
            <span class="ar-yc-lbl">{anneeCourt(y.annee)}</span>
            <span class="ar-yc-n" data-count>{y.nbDispo}</span>
          </a>
        ))}
      </div>

      {/* ── Liste par année ── */}
      <div class="ar-list">
        {parAnnee.map((y) => (
          <details class="ar-year" id={`annee-${y.annee}`} data-annee={y.annee} open={y.annee === premiereAnneeOuverte || y.annee === RENTREE_COURANTE}>
            <summary>
              <span class="ar-y-title">
                Année scolaire {anneeLabel(y.annee)}
                {y.annee === RENTREE_COURANTE && <span class="ar-tag ar-tag--now">En cours</span>}
              </span>
              <span class="ar-y-meta" data-meta>
                {y.nbDispo ? `${y.nbDispo} en ligne` : 'Archives en cours de mise en ligne'}
                {y.nbAVenir ? ` · ${y.nbAVenir} à venir` : ''}
              </span>
              <span class="ar-chevron" aria-hidden="true"></span>
            </summary>

            <div class="ar-y-body">
              {y.groupes.map((g) => (
                <section class="ar-group" data-niveau={g.niveau} style={`--c:${NIVEAUX[g.niveau].couleur}`}>
                  <h3 class="ar-group-title"><i aria-hidden="true"></i>{NIVEAUX[g.niveau].label}</h3>
                  <ul class="ar-rows">
                    {g.list.map((d) => (
                      <li class:list={['ar-row', { 'is-soon': !d.dispo }]} id={d.id} data-niveau={d.niveau} data-dispo={d.dispo ? '1' : '0'} data-search={d.search}>
                        <div class="ar-row-main">
                          <div class="ar-row-title">
                            <strong>{d.titre}</strong>
                            {d.categorie && <span class="ar-tag">{d.categorie}</span>}
                            {d.nouveau && d.dispo && <span class="ar-tag ar-tag--new">Nouveau</span>}
                          </div>
                          {(d.chapitres || d.duree) && (
                            <div class="ar-row-sub">
                              {d.chapitres}{d.chapitres && d.duree ? ' · ' : ''}{d.duree && <span class="ar-dur">⏱ {d.duree}</span>}
                            </div>
                          )}
                        </div>
                        <div class="ar-row-act">
                          {!d.dispo ? (
                            <span class="ar-btn is-off" title="Ce document sera bientôt en ligne">⏳ Bientôt en ligne</span>
                          ) : (
                            <>
                              {d.okS ? (
                                <a class="ar-btn" href={d.sujet} data-ar-src={d.sujet} data-ar-title={`${d.titre} — ${NIVEAUX[d.niveau].label} ${anneeLabel(d.annee)} (Sujet)`}>📄 Sujet</a>
                              ) : (
                                <span class="ar-btn is-off" title="Énoncé bientôt en ligne">📄 Bientôt</span>
                              )}
                              {d.okC ? (
                                <button type="button" class="doc-tab ar-btn ar-btn--corr" data-src={d.corrige} data-title={`${d.titre} — ${NIVEAUX[d.niveau].label} ${anneeLabel(d.annee)} (Corrigé)`} data-ar-src={d.corrige}>✅ Corrigé</button>
                              ) : d.corrige ? (
                                <span class="ar-btn is-off" title="Corrigé bientôt en ligne">✅ Bientôt</span>
                              ) : (
                                <span class="ar-btn is-off" title="Pas de corrigé pour ce devoir">Sans corrigé</span>
                              )}
                            </>
                          )}
                          {d.okS && (
                            <button type="button" class="ar-share" data-ar-share={d.sujet} data-ar-name={`${d.titre} — ${NIVEAUX[d.niveau].label} ${anneeLabel(d.annee)}`} title="Copier le lien pour le partager" aria-label="Partager">🔗</button>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
              <p class="ar-empty" data-empty hidden={y.groupes.length > 0}>
                {y.groupes.length > 0
                  ? 'Aucun document ne correspond à ce filtre pour cette année.'
                  : <>Les sujets de cette année seront publiés progressivement. Vous en avez un ? <a href="/contact">Partagez-le avec nous</a>.</>}
              </p>
            </div>
          </details>
        ))}
      </div>
    </>
  ) : (
    <>
      {/* ── Examens nationaux : choix de la filière ── */}
      <div class="ar-tools">
        <div class="ar-chips ar-chips--seg" role="tablist" aria-label="Filière du Baccalauréat">
          {filieres.map((f, i) => (
            <button type="button" role="tab" class:list={['ar-chip', { 'is-active': i === 0 }]} data-filiere={f.k} aria-selected={i === 0 ? 'true' : 'false'} style={`--c:${NIVEAUX[f.niveau].couleur}`}>
              <i aria-hidden="true"></i>{f.label}<small>{f.court}</small>
            </button>
          ))}
        </div>
      </div>

      {filieres.map((f, i) => (
        <section class="ar-matrix" data-filiere={f.k} hidden={i !== 0} style={`--c:${NIVEAUX[f.niveau].couleur}`}>
          <p class="ar-matrix-cap">
            <strong>Bac {f.label}</strong> — {f.nbSujets} sujet{f.nbSujets > 1 ? 's' : ''} et {f.nbCorriges} corrigé{f.nbCorriges > 1 ? 's' : ''} en ligne sur les {NB_ANNEES} dernières sessions.
          </p>
          <div class="ar-table-wrap">
            <table class="ar-table">
              <thead>
                <tr>
                  <th scope="col" rowspan="2">Session</th>
                  <th scope="colgroup" colspan="2">Session normale <small>(juin)</small></th>
                  <th scope="colgroup" colspan="2">Rattrapage <small>(juillet)</small></th>
                </tr>
                <tr>
                  <th scope="col">Sujet</th><th scope="col">Corrigé</th>
                  <th scope="col">Sujet</th><th scope="col">Corrigé</th>
                </tr>
              </thead>
              <tbody>
                {f.rows.map((r) => (
                  <tr id={`bac-${f.k}-${r.annee}`} class:list={{ 'is-soon': !(r.normale.okS || r.rattrapage.okS) }}>
                    <th scope="row">
                      {r.annee}
                      {r.annee === SESSION_COURANTE && <span class="ar-tag ar-tag--now">Dernière</span>}
                    </th>
                    {(['normale', 'rattrapage'] as const).map((s) => {
                      const e = r[s];
                      const lbl = `Bac ${f.court} ${r.annee} — ${sessionLabel[s]}`;
                      return (
                        <>
                          <td>
                            {e.okS
                              ? <a class="ar-btn ar-btn--sm" aria-label={`${lbl} — sujet`} href={e.sujet} data-ar-src={e.sujet} data-ar-title={`${lbl} (Sujet)`}>📄<span class="ar-bl"> Sujet</span></a>
                              : <span class="ar-dash" title="Bientôt en ligne">—</span>}
                          </td>
                          <td>
                            {e.okC
                              ? <button type="button" aria-label={`${lbl} — corrigé`} class="doc-tab ar-btn ar-btn--sm ar-btn--corr" data-src={e.corrige} data-title={`${lbl} (Corrigé)`} data-ar-src={e.corrige}>✅<span class="ar-bl"> Corrigé</span></button>
                              : <span class="ar-dash" title="Bientôt en ligne">—</span>}
                          </td>
                        </>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="ar-legend"><span class="ar-dash">—</span> document pas encore en ligne : les archives sont ajoutées progressivement.</p>
        </section>
      ))}
    </>
  )}

  {/* ── Visionneuse (s'ouvre par-dessus la page) ── */}
  <div class="doc-viewer ar-viewer" role="dialog" aria-modal="true" aria-label="Visionneuse de document">
    <div class="doc-toolbar">
      <span class="doc-current">Document</span>
      <a class="doc-download" href="#" download>⬇️ Télécharger</a>
      <button type="button" class="ar-close" aria-label="Fermer la visionneuse">✕</button>
    </div>
    <iframe class="doc-frame" src="about:blank" title="Visionneuse de document"></iframe>
  </div>
  <div class="ar-toast" role="status" aria-live="polite"></div>
</div>

<script>
  const norm = (s: string) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const CORRIG_RE = /corrig|correction/i;
  const isUnlocked = () => {
    try {
      const v = localStorage.getItem('me-corriges-ok');
      if (!v) return false;
      if (v === 'unlimited') return true;
      const t = parseInt(v, 10);
      return !!t && Date.now() < t;
    } catch { return false; }
  };

  function init() {
    const root = document.querySelector<HTMLElement>('.ar-root');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    /* ── Visionneuse ── */
    const viewer = root.querySelector<HTMLElement>('.ar-viewer')!;
    const frame = viewer.querySelector<HTMLIFrameElement>('.doc-frame')!;
    const cur = viewer.querySelector<HTMLElement>('.doc-current')!;
    const dl = viewer.querySelector<HTMLAnchorElement>('.doc-download')!;
    const toast = root.querySelector<HTMLElement>('.ar-toast')!;
    // La visionneuse et le toast sont déplacés sous <body> : un parent
    // transformé les enfermerait sinon dans la colonne de contenu.
    document.body.appendChild(viewer);
    document.body.appendChild(toast);
    const small = () => window.matchMedia('(max-width: 720px)').matches;

    const say = (msg: string) => {
      toast.textContent = msg;
      toast.classList.add('is-on');
      setTimeout(() => toast.classList.remove('is-on'), 2600);
    };
    const openViewer = () => {
      viewer.classList.add('is-open');
      document.documentElement.classList.add('ar-noscroll');
    };
    const closeViewer = () => {
      viewer.classList.remove('is-open');
      document.documentElement.classList.remove('ar-noscroll');
      frame.setAttribute('src', 'about:blank');
      if (location.hash.startsWith('#doc=')) history.replaceState(null, '', location.pathname + location.search);
    };
    const show = (src: string, title: string) => {
      if (small()) { window.open(src, '_blank', 'noopener'); return; } // mobile : lecteur PDF natif
      frame.setAttribute('src', src);
      dl.setAttribute('href', src);
      const nt = viewer.querySelector<HTMLAnchorElement>('.doc-newtab');
      if (nt) nt.setAttribute('href', src);
      cur.textContent = title;
      openViewer();
    };

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const btn = t.closest<HTMLElement>('[data-ar-src]');
      if (btn) {
        e.preventDefault();
        show(btn.dataset.arSrc!, btn.dataset.arTitle || btn.dataset.title || '');
        return;
      }
      const sh = t.closest<HTMLElement>('[data-ar-share]');
      if (sh) {
        const url = `${location.origin}${location.pathname}#doc=${sh.dataset.arShare}`;
        const name = sh.dataset.arName || document.title;
        if (navigator.share && small()) {
          navigator.share({ title: name, url }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(() => say('🔗 Lien copié — collez-le sur WhatsApp !'), () => say(url));
        } else { say(url); }
        return;
      }
    });
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer || (e.target as HTMLElement).closest('.ar-close')) closeViewer();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && viewer.classList.contains('is-open')) closeViewer(); });

    // Lien direct #doc=… (géré par docviewer.js) : on ouvre la visionneuse.
    new MutationObserver(() => {
      const src = frame.getAttribute('src') || '';
      if (!src || src === 'about:blank' || viewer.classList.contains('is-open')) return;
      if (CORRIG_RE.test(src) && !isUnlocked()) {
        // Corrigé verrouillé : on montre le bouton au lieu d'ouvrir.
        frame.setAttribute('src', 'about:blank');
        const b = root.querySelector<HTMLElement>(`[data-ar-src="${CSS.escape(src)}"]`);
        if (b) {
          b.closest('details')?.setAttribute('open', '');
          b.scrollIntoView({ block: 'center', behavior: 'smooth' });
          b.classList.add('is-flash');
          say('🔒 Cliquez sur « Corrigé » pour débloquer les corrigés (gratuit).');
        }
        return;
      }
      const b = root.querySelector<HTMLElement>(`[data-ar-src="${CSS.escape(src)}"]`);
      if (b && !cur.textContent?.trim()) cur.textContent = b.dataset.arTitle || '';
      if (small()) { frame.setAttribute('src', 'about:blank'); window.open(src, '_blank', 'noopener'); return; }
      openViewer();
    }).observe(frame, { attributes: true, attributeFilter: ['src'] });

    // Cadenas sur les corrigés tant que l'accès n'est pas débloqué.
    if (!isUnlocked()) root.querySelectorAll('.ar-btn--corr').forEach((b) => b.classList.add('is-locked'));

    const params = new URLSearchParams(location.search);

    /* ── Examens nationaux : onglets de filière ── */
    const tabs = root.querySelectorAll<HTMLElement>('[data-filiere].ar-chip');
    if (tabs.length) {
      const pick = (k: string) => {
        tabs.forEach((t) => {
          const on = t.dataset.filiere === k;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll<HTMLElement>('.ar-matrix').forEach((m) => { m.hidden = m.dataset.filiere !== k; });
      };
      tabs.forEach((t) => t.addEventListener('click', () => {
        pick(t.dataset.filiere!);
        const u = new URL(location.href); u.searchParams.set('filiere', t.dataset.filiere!);
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      }));
      const f = params.get('filiere') || (params.get('niveau') === 'terminale-pc' ? 'pc' : null);
      if (f && root.querySelector(`.ar-matrix[data-filiere="${f}"]`)) pick(f);
      return;
    }

    /* ── DS / DM / EB : filtres ── */
    const chips = root.querySelectorAll<HTMLElement>('.ar-chip[data-niveau]');
    const input = root.querySelector<HTMLInputElement>('.ar-search input')!;
    const dispoOnly = root.querySelector<HTMLInputElement>('.ar-dispo-only')!;
    const years = root.querySelectorAll<HTMLDetailsElement>('details.ar-year');
    let niveau = 'all';

    const apply = (fromSearch = false) => {
      const q = norm(input.value.trim());
      years.forEach((y) => {
        let vis = 0, visDispo = 0, visSoon = 0;
        y.querySelectorAll<HTMLElement>('.ar-group').forEach((g) => {
          let gv = 0;
          g.querySelectorAll<HTMLElement>('.ar-row').forEach((r) => {
            const ok = (niveau === 'all' || r.dataset.niveau === niveau)
              && (!dispoOnly.checked || r.dataset.dispo === '1')
              && (!q || (r.dataset.search || '').includes(q));
            r.hidden = !ok;
            if (ok) { gv++; if (r.dataset.dispo === '1') visDispo++; else visSoon++; }
          });
          g.hidden = gv === 0;
          vis += gv;
        });
        const empty = y.querySelector<HTMLElement>('[data-empty]');
        if (empty) empty.hidden = vis > 0;
        const meta = y.querySelector<HTMLElement>('[data-meta]');
        if (meta) meta.textContent = (visDispo ? `${visDispo} en ligne` : 'Archives en cours de mise en ligne') + (visSoon ? ` · ${visSoon} à venir` : '');
        const chip = root.querySelector<HTMLElement>(`.ar-year-chip[data-annee="${y.dataset.annee}"]`);
        if (chip) {
          chip.classList.toggle('is-empty', visDispo === 0);
          const n = chip.querySelector('[data-count]'); if (n) n.textContent = String(visDispo);
        }
        if (fromSearch && q && vis > 0) y.open = true;
      });
    };

    const setNiveau = (n: string, push = true) => {
      niveau = n;
      chips.forEach((c) => c.classList.toggle('is-active', c.dataset.niveau === n));
      apply();
      if (push) {
        const u = new URL(location.href);
        if (n === 'all') u.searchParams.delete('niveau'); else u.searchParams.set('niveau', n);
        history.replaceState(null, '', u.pathname + u.search + u.hash);
      }
    };
    chips.forEach((c) => c.addEventListener('click', () => setNiveau(c.dataset.niveau!)));
    input.addEventListener('input', () => apply(true));
    dispoOnly.addEventListener('change', () => apply());

    root.querySelectorAll<HTMLAnchorElement>('.ar-year-chip').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      const y = root.querySelector<HTMLDetailsElement>(`#annee-${a.dataset.annee}`);
      if (!y) return;
      y.open = true;
      y.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));

    const n0 = params.get('niveau');
    if (n0 && root.querySelector(`.ar-chip[data-niveau="${n0}"]`)) setNiveau(n0, false);
    const a0 = params.get('annee') || (location.hash.match(/^#annee-(\d{4})$/) || [])[1];
    if (a0) {
      const y = root.querySelector<HTMLDetailsElement>(`#annee-${a0}`);
      if (y) { y.open = true; setTimeout(() => y.scrollIntoView({ block: 'start' }), 50); }
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>

