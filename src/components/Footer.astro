---
/* ────────────────────────────────────────────────────────────
   MathsElites — Override du pied de page Starlight
   Ajoute un lien discret « Signaler une erreur » (WhatsApp) sous
   le contenu de chaque page de chapitre. Le nom du chapitre est
   repris automatiquement depuis le titre de la page (frontmatter),
   ainsi que l'URL, pour identifier tout de suite la page concernée.

   Pour changer le numéro : modifiez WA_NUMBER (format international,
   sans + ni espaces) — identique au bouton WhatsApp flottant.
   ──────────────────────────────────────────────────────────── */
import Default from '@astrojs/starlight/components/Footer.astro';

// Liens du canal de diffusion (Telegram / WhatsApp) — voir src/nouveautes.mjs
import { canal } from '../nouveautes.mjs';

// Données de la page courante (API Starlight ≥ 0.30)
const { entry, slug } = Astro.locals.starlightRoute;
const title = entry.data.title;

// Numéro WhatsApp — identique au bouton flottant (public/wa-button.js)
const WA_NUMBER = '212661892588';

// Pages SANS le lien : accueil, présentations de niveau et pages utilitaires.
// Tout le reste (cours, séries, DS, DM, examens blancs…) affiche le lien.
const SANS_LIEN = ['', 'index', 'a-propos', 'contact', 'mentions-legales', 'confidentialite', 'premiere', 'terminale', 'prepas'];
const afficher = !SANS_LIEN.includes(slug);

// URL absolue de la page (utile pour retrouver le chapitre concerné)
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// Message WhatsApp pré-rempli
const message =
  `Bonjour, je signale une erreur sur le chapitre : ${title}.\n` +
  `Page : ${pageUrl}\n` +
  `Voici le problème : `;

const waHref = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`;

// Bouton « Rejoindre le canal » (pied de page global). N'apparaît que si
// au moins un lien est renseigné dans src/nouveautes.mjs.
const aTelegram = canal.telegram && canal.telegram.trim() !== '';
const aWhatsapp = canal.whatsapp && canal.whatsapp.trim() !== '';
const aCanal = aTelegram || aWhatsapp;
---

{
  afficher && (
    <div class="me-report">
      <a
        class="me-report-link"
        href={waHref}
        target="_blank"
        rel="noopener"
        aria-label="Signaler une erreur sur ce chapitre via WhatsApp"
      >
        <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
          <path d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.7 1.9 6.7L3 29l7-1.8c1.9 1 4 1.6 6 1.6 7 0 12.5-5.5 12.5-12.5S23 3 16 3zm0 22.6c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4a10 10 0 01-1.6-5.6C5.4 9.6 10.1 5 16 5s10.6 4.6 10.6 10.5S21.9 25.6 16 25.6zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.8 5.1.8.3 1.5.5 2 .7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z" />
        </svg>
        <span>Signaler une erreur sur ce chapitre</span>
      </a>
    </div>
  )
}

{/* Pied de page Starlight par défaut (dernière mise à jour, pagination…) */}
<Default {...Astro.props}><slot /></Default>

{/* Emplacement des statistiques de fréquentation (rempli par /site-stats.js) :
    nombre total de visiteurs + visiteurs en ligne. Présent sur toutes les
    pages de cours. Sur la page d'accueil (splash), le script se replie
    automatiquement en fin de contenu. */}
{aCanal && (
  <div class="me-canal">
    <span class="me-canal-txt">Soyez prévenu·e des nouveaux documents &amp; vidéos :</span>
    <span class="me-canal-btns">
      {aTelegram && (
        <a class="me-canal-btn me-canal-tg" href={canal.telegram} target="_blank" rel="noopener">Rejoindre le canal Telegram</a>
      )}
      {aWhatsapp && (
        <a class="me-canal-btn me-canal-wa" href={canal.whatsapp} target="_blank" rel="noopener">Rejoindre le canal WhatsApp</a>
      )}
    </span>
  </div>
)}

<div id="me-stats-slot"></div>

<footer class="me-footer not-content">
  <div class="me-footer__grid">
    <div class="me-footer__brand">
      <p class="me-footer__logo">Maths<em>Elites</em></p>
      <p class="me-footer__tag">Plateforme de mathématiques pour la Première Bac SM, la Terminale SM et les Classes Prépas — Maroc.</p>
      <p class="me-footer__social">
        <a href="https://www.youtube.com/@mathselites" target="_blank" rel="noopener">YouTube</a>
        <a href="https://www.instagram.com/mathselites.pro" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=1308180605710026" target="_blank" rel="noopener">Facebook</a>
      </p>
    </div>
    <nav aria-label="Niveaux">
      <p class="me-footer__h">Niveaux</p>
      <ul>
        <li><a href="/premiere/">Première Bac SM</a></li>
        <li><a href="/terminale/">Terminale SM</a></li>
        <li><a href="/terminale-pc/">Terminale PC</a></li>
        <li><a href="/prepas/">Classes Prépas</a></li>
      </ul>
    </nav>
    <nav aria-label="Ressources">
      <p class="me-footer__h">Ressources</p>
      <ul>
        <li><a href="/devoirs-surveilles">Devoirs surveillés</a></li>
        <li><a href="/examens-nationaux">Examens nationaux</a></li>
        <li><a href="/probleme-de-la-semaine">Problème de la semaine</a></li>
        <li><a href="/stages">Stages</a></li>
      </ul>
    </nav>
    <nav aria-label="Informations">
      <p class="me-footer__h">Informations</p>
      <ul>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/confidentialite">Confidentialité</a></li>
      </ul>
    </nav>
  </div>
  <p class="me-footer__copy">© {new Date().getFullYear()} MathsElites — R. Abed. Tous droits réservés. Usage pédagogique personnel autorisé.</p>
</footer>

<style>
  .me-footer {
    margin: 3rem calc(var(--sl-content-pad-x, 1rem) * -1) -2rem;
    padding: 2.4rem var(--sl-content-pad-x, 1rem) 1.4rem;
    background: #0a1c33; color: #cfdcee; border-top: 3px solid #c9a227;
  }
  .me-footer__grid {
    display: grid; gap: 2rem 2.5rem; max-width: 62rem; margin: 0 auto;
    grid-template-columns: 1.6fr repeat(3, 1fr);
  }
  .me-footer__logo {
    font-family: var(--me-font-display); font-size: 1.5rem; font-weight: 600;
    color: #fff; margin: 0 0 .5rem;
  }
  .me-footer__logo em { color: #e3c24e; font-style: italic; }
  .me-footer__tag { font-size: .85rem; line-height: 1.6; margin: 0 0 1rem; color: #b9c8dc; max-width: 30ch; }
  .me-footer__social { display: flex; gap: 1rem; margin: 0; font-size: .85rem; }
  .me-footer__h {
    font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #e3c24e; margin: 0 0 .8rem;
  }
  .me-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; font-size: .88rem; }
  .me-footer a { color: #cfdcee; text-decoration: none; }
  .me-footer a:hover { color: #fff; text-decoration: underline; text-decoration-color: #c9a227; }
  .me-footer__copy {
    max-width: 62rem; margin: 2rem auto 0; padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,.12); font-size: .78rem; color: #8ea3bf;
  }
  @media (max-width: 760px) {
    .me-footer__grid { grid-template-columns: 1fr 1fr; }
    .me-footer__brand { grid-column: 1 / -1; }
  }
  .me-report {
    margin: 1.75rem 0 0.5rem;
  }

  .me-report-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6, transparent);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .me-report-link:hover,
  .me-report-link:focus-visible {
    color: #128c7e; /* vert WhatsApp */
    border-color: #25d366;
    background: color-mix(in srgb, #25d366 8%, transparent);
  }

  .me-report-link svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: #25d366;
  }

  .me-canal {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: .6rem .9rem; margin: 1.75rem 0 .5rem; padding: .85rem 1rem;
    border-radius: 12px; border: 1px solid var(--sl-color-gray-5);
    background: linear-gradient(90deg, rgba(29,78,216,.08), rgba(201,162,39,.08));
    text-align: center;
  }
  .me-canal-txt { font-size: .86rem; font-weight: 600; color: var(--sl-color-gray-2); }
  .me-canal-btns { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .me-canal-btn {
    display: inline-block; padding: .4rem .9rem; border-radius: 9999px;
    font-size: .82rem; font-weight: 700; color: #fff !important; text-decoration: none;
    white-space: nowrap; transition: opacity .15s ease;
  }
  .me-canal-btn:hover { opacity: .9; }
  .me-canal-tg { background: #229ED9; }
  .me-canal-wa { background: #25D366; }
</style>
