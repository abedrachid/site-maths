---
const title = 'Page introuvable';
const description = 'La page demandée est introuvable sur Maths-Expert.';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Maths-Expert</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: radial-gradient(circle at top, #f5f0fa 0%, #eef6ff 45%, #ffffff 100%);
        color: #1e1b2e;
        font-family: Arial, Helvetica, sans-serif;
      }

      .card {
        width: min(720px, calc(100vw - 2rem));
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid #e2d9f3;
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 18px 50px rgba(30, 27, 46, 0.08);
        text-align: center;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 9999px;
        background: #f5f0fa;
        color: #7c3aed;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.1rem, 4vw, 3.2rem);
        line-height: 1.05;
      }

      p {
        margin: 0 auto 1.5rem;
        max-width: 54ch;
        color: #4b5563;
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        gap: 0.9rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      a {
        display: inline-block;
        border-radius: 9999px;
        padding: 0.8rem 1.3rem;
        text-decoration: none;
        font-weight: 700;
      }

      .primary {
        background: #7c3aed;
        color: white;
        box-shadow: 0 10px 24px rgba(124, 58, 237, 0.22);
      }

      .secondary {
        background: white;
        color: #1e1b2e;
        border: 1px solid #e2d9f3;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <span class="eyebrow">404</span>
      <h1>Page introuvable</h1>
      <p>
        Le lien demandé n’existe pas ou a été déplacé. Revenez à l’accueil ou
        choisissez directement votre niveau pour continuer la navigation.
      </p>
      <div class="actions">
        <a class="primary" href="/">Retour à l’accueil</a>
        <a class="secondary" href="/terminale/">Terminale SM</a>
        <a class="secondary" href="/prepas/">Classes Prépas</a>
      </div>
    </main>
  </body>
</html>
